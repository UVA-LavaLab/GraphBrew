      "graph_set": "synthetic_kron12_all",
      "benchmarks": ["pr", "bfs", "sssp", "bc", "cc"],
      "policies": [
        "LRU", "SRRIP", "GRASP", "POPT",
        "ECG:K2", "ECG:K2_ONLINE",
