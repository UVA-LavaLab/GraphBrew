{
  "version": 2,
  "description": "ECG successor HPCA artifact manifest.",
  "defaults": {
    "l1d_size": "32kB",
    "l2_size": "256kB",
    "l1d_ways": "8",
    "l2_ways": "8",
    "l3_sizes": ["2MB"],
    "l3_ways": "16",
    "line_size": "64",
    "timeout_cache": 1800,
    "timeout_gem5": 7200,
    "timeout_sniper": 21600,
    "sniper_root": "bench/include/sniper_sim/snipersim",
    "sniper_frontend": "sift",
    "sniper_omp_wait_policy": "passive",
    "sniper_memory_limit_gb": 12,
    "sniper_base_config": "graphbrew/graph_sniper",
    "sniper_mimicos_memory_mb": 4096,
    "sniper_mimicos_kernel_mb": 128,
    "popt_reserve_model": "size_correct",
    "ecg_epoch_pack_bits": 64,
    "require_cache_sim_aslr_disable": true,
    "no_build": true
  },
  "profiles": {
    "ecg_smoke": "Fast cache_sim smoke for the complete ECG policy set.",
    "ecg_3sim_allalg_smoke": "Bounded 3-simulator x 5-algorithm x 8-policy smoke matrix for final row/metric coverage.",
    "ecg_3sim_realgraph_allalg": "Three-simulator x three-real-graph x five-algorithm x eight-policy no-prefetch comparison.",
    "ecg_preliminary_5alg_3sim": "Bounded five-algorithm, six-policy diagnostic matrix on a common synthetic graph across cache_sim, gem5, and Sniper.",
    "ecg_preliminary_5alg_stride": "Matched STRIDE8 sensitivity for the bounded five-algorithm, six-policy three-simulator diagnostic matrix.",
    "ecg_replacement_baseline": "Equal-capacity PR/BFS/SSSP/BC/CC replacement study with charged and uncharged P-OPT plus every static K2 arm.",
    "ecg_online_dueling": "Online K2 set-dueling regret study against every static K2 arm.",
    "ecg_streamshield_generality": "Real-graph all-kernel comparison of always-allocate, static StreamShield, and adaptive placement with the full baseline set.",
    "ecg_cache_sim_factorial": "Real-graph K1/K2 x StreamShield cache_sim factorial with the full baseline set.",
    "gem5_streamshield_mechanism": "Synthetic gem5 mechanism cell for fused K2 versus K2+StreamShield.",
    "sniper_streamshield_mechanism": "Synthetic Sniper mechanism cell for fused K2 versus K2+StreamShield.",
    "streamshield_sniper_realgraph": "Pending-calibration full-iteration web-Google PR Sniper matrix; do not freeze results with the rejected generic STRIDE8 configuration."
  },
  "benchmark_options": {
    "synthetic_pr": {
      "pr": "-g 12 -k 16 -o 5 -n 1 -i 1"
    },
    "synthetic_kron12_all": {
      "pr": "-g 12 -k 4 -o 5 -n 1 -i 1",
      "bfs": "-g 12 -k 4 -o 5 -n 1 -r 0",
      "sssp": "-g 12 -k 4 -o 5 -n 1 -r 0",
      "bc": "-g 12 -k 4 -o 5 -n 1 -i 1",
      "cc": "-g 12 -k 4 -o 5 -n 1"
    },
    "synthetic_kron4_pr": {
      "pr": "-g 16 -k 4 -o 5 -n 1 -i 1"
    },
    "synthetic_kron16_pr": {
      "pr": "-g 16 -k 16 -o 5 -n 1 -i 1"
    },
    "synthetic_kron15_all": {
      "pr": "-g 15 -k 4 -o 5 -n 1 -i 1",
      "bfs": "-g 15 -k 4 -o 5 -n 1 -r 212",
      "sssp": "-g 15 -k 4 -o 5 -n 1 -r 212",
      "bc": "-g 15 -k 4 -o 5 -n 1 -i 1",
      "cc": "-g 15 -k 4 -o 5 -n 1"
    },
    "file_pr_i1_dbg": {
      "pr": "-f {graph_path} -o 5 -n 1 -i 1"
    },
    "file_all_kernels_dbg": {
      "pr": "-f {graph_path} -o 5 -n 1 -i 1",
      "bfs": "-f {graph_path} -o 5 -n 1 -r 212",
      "sssp": "-f {graph_path} -o 5 -n 1 -r 212",
      "bc": "-f {graph_path} -o 5 -n 1 -i 1",
      "cc": "-f {graph_path} -o 5 -n 1"
    }
  },
