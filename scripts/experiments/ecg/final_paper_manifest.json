      "name": "01_ecg_cache_sim_smoke",
      "kind": "roi_matrix",
      "profiles": ["ecg_smoke"],
      "suite": "cache-sim",
      "graph_set": "synthetic_smoke",
      "benchmarks": ["pr"],
      "policies": ["LRU", "SRRIP", "GRASP", "POPT", "ECG:K2", "ECG:K2_ONLINE", "ECG:K2_STREAMSHIELD"],
      "popt_reserve_model": "size_correct",
      "prefetcher": "STRIDE",
      "out_subdir": "01_ecg_cache_sim_smoke",
      "timeout_cache": 600
    },
    {
